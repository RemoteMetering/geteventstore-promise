{
	"name": "@metronomic/kurrentdb-client",
	"version": "4.0.1",
	"description": "KurrentDB client wrapper",
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"types": "./index.d.ts",
	"scripts": {
		"test": "yarn test:insecure && yarn test:secure",
		"test:insecure": "NODE_ENV=test mocha --exit --ignore 'tests/tcp.*' tests/",
		"test:secure": "NODE_ENV=test TESTS_RUN_SECURE=true mocha --exit --ignore 'tests/tcp.*' tests/",
		"test:grpc": "NODE_ENV=test TESTS_RUN_SECURE=false mocha --exit tests/grpc.*",
		"test:v21": "yarn test:v21:insecure && yarn test:v21:secure",
		"test:v21:insecure": "NODE_ENV=test TESTS_V21=true mocha --exit tests/",
		"test:v21:secure": "NODE_ENV=test TESTS_V21=true TESTS_RUN_SECURE=true mocha --exit tests/",
		"coverage": "NODE_ENV=test TESTS_RUN_SECURE=true c8 mocha --exit --ignore 'tests/tcp.*' tests/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/RemoteMetering/kurrentdb-client.git"
	},
	"keywords": [
		"node",
		"client",
		"event store",
		"geteventstore",
		"eventstore",
		"kurrent",
		"kurrentdb"
	],
	"author": "METRONOMIC Team",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/RemoteMetering/kurrentdb-client/issues"
	},
	"homepage": "https://github.com/RemoteMetering/kurrentdb-client",
	"dependencies": {
		"@kurrent/kurrentdb-client": "^1.3.1",
		"axios": "^1.18.1",
		"debug": "^4.4.3",
		"generic-pool": "^3.9.0",
		"lodash.clonedeep": "^4.5.0",
		"node-eventstore-client": "^23.10.1"
	},
	"devDependencies": {
		"c8": "^11.0.0",
		"mocha": "^11.7.6"
	},
	"c8": {
		"reporter": [
			"lcov",
			"text",
			"html"
		],
		"include": [
			"lib/**"
		],
		"exclude": [
			"lib/AggRoot.js"
		],
		"all": true
	},
	"engines": {
		"node": ">=20"
	}
}
