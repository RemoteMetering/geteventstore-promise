{
	"name": "geteventstore-promise",
	"version": "4.0.1",
	"description": "GetEventStore client wrapper using promises",
	"main": "index.js",
	"scripts": {
		"test": "yarn test:insecure && yarn test:secure",
		"test:insecure": "NODE_ENV=test mocha --exit --ignore 'tests/tcp.*' --require @babel/register tests/",
		"test:secure": "NODE_ENV=test TESTS_RUN_SECURE=true mocha --exit --ignore 'tests/tcp.*' --require @babel/register tests/",
		"test:grpc": "NODE_ENV=test TESTS_RUN_SECURE=false mocha --exit --require @babel/register tests/grpc.*",
		"coverage": "nyc yarn test",
		"build": "babel --delete-dir-on-start -d dist/ lib"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/RemoteMetering/geteventstore-promise.git"
	},
	"keywords": [
		"node",
		"client",
		"event store",
		"geteventstore",
		"eventstore",
		"promise"
	],
	"author": "Remote Metering Solutions Team",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/RemoteMetering/geteventstore-promise/issues"
	},
	"homepage": "https://github.com/RemoteMetering/geteventstore-promise",
	"dependencies": {
		"@babel/runtime": "^8.0.0",
		"@kurrent/kurrentdb-client": "^1.3.1",
		"axios": "^1.18.1",
		"debug": "^4.4.3",
		"generic-pool": "^3.9.0",
		"lodash.clonedeep": "^4.5.0",
		"node-eventstore-client": "^23.10.1"
	},
	"devDependencies": {
		"@babel/cli": "^8.0.1",
		"@babel/core": "^8.0.1",
		"@babel/node": "^8.0.1",
		"@babel/plugin-transform-runtime": "^8.0.1",
		"@babel/preset-env": "^8.0.2",
		"@babel/register": "^8.0.1",
		"babel-plugin-add-module-exports": "^1.0.4",
		"mocha": "^11.7.6",
		"nyc": "^18.0.0"
	},
	"nyc": {
		"reporter": [
			"lcov",
			"text",
			"html"
		],
		"include": [
			"lib/*"
		],
		"exclude": [
			"lib/AggRoot.js"
		],
		"all": true
	},
	"engines": {
		"node": ">=24"
	}
}
